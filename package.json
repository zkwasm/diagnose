{
  "name": "@masstensor/diagnose",
  "version": "0.8.5",
  "description": "Agent-led remote troubleshooting and problem resolution, with end-to-end encryption and user-controlled permissions",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "diagnose": "dist/cli.js",
    "diagnose-relay": "dist/relay-main.js"
  },
  "files": [
    "dist",
    "README.md",
    "USER_GUIDE.md",
    "docs/guide",
    "LICENSE",
    "npm-shrinkwrap.json",
    "src",
    "tsconfig.json",
    "test/*.test.ts",
    "test/noise-vector.json",
    "deploy",
    "test/CACOPHONY-LICENSE",
    "examples/skills",
    "skills/connect",
    "scripts/setup-node.sh",
    "scripts/setup-node.ps1",
    "KNOWLEDGE_SECURITY.md",
    "DEVELOPMENT_PLAN.md",
    "PAIRING_PROTOCOL.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "prepack": "npm run build",
    "postinstall": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('dist/prepare-pty.js')) await (await import('./dist/prepare-pty.js')).preparePty();\"",
    "build:site": "tsc -p site/tsconfig.json && node --experimental-strip-types site/build.ts",
    "check:site": "node --experimental-strip-types site/check.ts",
    "video:render": "node --experimental-strip-types video/render-en.ts",
    "video:preview": "node --experimental-strip-types video/render-en.ts --preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@serenity-kit/opaque": "1.1.0",
    "node-pty": "1.1.0",
    "noise-handshake": "4.2.1",
    "serialport": "13.0.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "marked": "18.2.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkwasm/diagnose.git"
  },
  "homepage": "https://diagnose.fenginwind.com",
  "bugs": {
    "url": "https://github.com/zkwasm/diagnose/issues"
  }
}
